PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/gym_crm
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# WhatsApp Cloud API (optional). Without these, the system still works -
# it generates wa.me click-to-chat links instead of auto-sending.
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
